@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header text-center">
                    <h3>Conference Check-in System</h3>
                    <p class="mb-0">Login</p>
                </div>

                <div class="card-body">
                    <form asp-action="Login" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="username"
                                   class="form-label">
                                Username
                            </label>

                            <input type="text"
                                   id="username"
                                   name="username"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label for="password"
                                   class="form-label">
                                Password
                            </label>

                            <input type="password"
                                   id="password"
                                   name="password"
                                   class="form-control"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Login
                        </button>

                    </form>

                    <div class="text-center mt-3">
                        <span>Don't have an account?</span>
                        <a asp-controller="Account"
                           asp-action="Register">
                            Register here
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}