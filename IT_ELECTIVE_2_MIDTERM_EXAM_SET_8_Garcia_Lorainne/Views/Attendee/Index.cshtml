@model IEnumerable<IT_ELECTIVE_2_MIDTERM_EXAM_SET_8_Garcia_Lorainne.Models.AttendeeVisit>

@{
    ViewData["Title"] = "Attendee Monitoring";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Conference Attendee Monitoring</h2>
            <p class="text-muted">
                Monitor attendee check-in and check-out
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Register Attendee
        </a>
    </div>

    <!-- Search -->
    <div class="card mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">
                <div class="row g-2">

                    <div class="col-md-10">
                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search ticket number, name, organization, or event..." />
                    </div>

                    <div class="col-md-2">
                        <button type="submit"
                                class="btn btn-secondary w-100">
                            Search
                        </button>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <!-- Monitoring Table -->
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Ticket Number</th>
                            <th>Attendee</th>
                            <th>Organization</th>
                            <th>Check-In</th>
                            <th>Check-Out</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var attendee in Model)
                            {
                                <tr>

                                    <td>
                                        @attendee.TicketNumber
                                    </td>

                                    <td>
                                        @attendee.FirstName
                                        @attendee.LastName
                                    </td>

                                    <td>
                                        @attendee.Organization
                                    </td>

                                    <td>
                                        @attendee.CheckInTime.ToString("MMM dd, yyyy hh:mm tt")
                                    </td>

                                    <td>
                                        @if (attendee.CheckOutTime.HasValue)
                                        {
                                            @attendee.CheckOutTime.Value.ToString("MMM dd, yyyy hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not checked out</span>
                                        }
                                    </td>

                                    <td>
                                        @if (attendee.Status == "Present")
                                        {
                                            <span class="badge bg-success">
                                                Present
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Left Event
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        <div class="d-flex gap-1 flex-wrap">

                                            <a asp-action="Details"
                                               asp-route-id="@attendee.Id"
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@attendee.Id"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            @if (attendee.Status == "Present")
                                            {
                                                <a asp-action="CheckOut"
                                                   asp-route-id="@attendee.Id"
                                                   class="btn btn-sm btn-danger">
                                                    Check-Out
                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted">
                                    No attendees found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>